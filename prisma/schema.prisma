// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Canonical product graph ──────────────────────────────────────────────
// CanonicalProduct (what it is) → ProductVariant (what size/format) →
// RetailerListing (what a retailer sells it for) → PriceObservation
// (what it has cost over time). Retailer listings are never treated as
// the source of truth for product identity.

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  canonicalProducts CanonicalProduct[]

  @@map("categories")
}

model Brand {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  logo        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  canonicalProducts CanonicalProduct[]

  @@map("brands")
}

model CanonicalProduct {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  categoryId  String
  brandId     String?
  strain      String?
  thcContent  Float?
  cbdContent  Float?
  effects     String[]
  flavors     String[]
  terpenes    String[]
  images      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id])
  brand    Brand?           @relation(fields: [brandId], references: [id])
  variants ProductVariant[]
  reviews  Review[]
  favorites Favorite[]
  userEvents UserEvent[]

  @@index([categoryId])
  @@index([brandId])
  @@map("canonical_products")
}

model ProductVariant {
  id                 String   @id @default(cuid())
  canonicalProductId String
  label              String // e.g. "3.5g", "10-pack", "1g cart"
  weight             Float?
  unit               String?
  sku                String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  canonicalProduct CanonicalProduct @relation(fields: [canonicalProductId], references: [id], onDelete: Cascade)
  listings         RetailerListing[]
  shoppingListItems ShoppingListItem[]
  alerts           Alert[]

  @@index([canonicalProductId])
  @@map("product_variants")
}

// ── Retailer side ─────────────────────────────────────────────────────────

model Retailer {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  listings RetailerListing[]

  @@map("retailers")
}

model RetailerListing {
  id            String   @id @default(cuid())
  retailerId    String
  variantId     String
  price         Float
  comparePrice  Float?
  inStock       Boolean  @default(true)
  stockQuantity Int      @default(0)
  featured      Boolean  @default(false)
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  retailer          Retailer         @relation(fields: [retailerId], references: [id])
  variant           ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  priceObservations PriceObservation[]

  @@unique([retailerId, variantId])
  @@index([variantId])
  @@map("retailer_listings")
}

model PriceObservation {
  id           String   @id @default(cuid())
  listingId    String
  price        Float
  comparePrice Float?
  observedAt   DateTime @default(now())

  listing RetailerListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, observedAt])
  @@map("price_observations")
}

// ── People + preferences ────────────────────────────────────────────────

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model Favorite {
  id                 String   @id @default(cuid())
  email              String
  canonicalProductId String
  createdAt          DateTime @default(now())

  canonicalProduct CanonicalProduct @relation(fields: [canonicalProductId], references: [id], onDelete: Cascade)

  @@unique([email, canonicalProductId])
  @@index([email])
  @@map("favorites")
}

// Raw behavioral signal feed for BudMatch. Kept generic (a type + a product
// reference) so new signal types don't require schema churn.
model UserEvent {
  id                 String   @id @default(cuid())
  email              String
  type               UserEventType
  canonicalProductId String
  createdAt          DateTime @default(now())

  canonicalProduct CanonicalProduct @relation(fields: [canonicalProductId], references: [id], onDelete: Cascade)

  @@index([email, createdAt])
  @@index([canonicalProductId])
  @@map("user_events")
}

enum UserEventType {
  VIEW
  FAVORITE
  UNFAVORITE
  CHAT_MENTION
}

model Review {
  id                 String   @id @default(cuid())
  canonicalProductId String
  email              String
  rating             Int
  comment            String?  @db.Text
  createdAt          DateTime @default(now())

  canonicalProduct CanonicalProduct @relation(fields: [canonicalProductId], references: [id], onDelete: Cascade)

  @@unique([canonicalProductId, email])
  @@index([canonicalProductId])
  @@map("reviews")
}

model ShoppingList {
  id        String   @id @default(cuid())
  email     String
  name      String   @default("My list")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ShoppingListItem[]

  @@index([email])
  @@map("shopping_lists")
}

model ShoppingListItem {
  id             String   @id @default(cuid())
  shoppingListId String
  variantId      String
  quantity       Int      @default(1)
  createdAt      DateTime @default(now())

  shoppingList ShoppingList   @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([shoppingListId, variantId])
  @@map("shopping_list_items")
}

model Alert {
  id          String    @id @default(cuid())
  email       String
  variantId   String
  type        AlertType
  targetPrice Float?
  createdAt   DateTime  @default(now())
  triggeredAt DateTime?

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([variantId])
  @@map("alerts")
}

enum AlertType {
  PRICE_DROP
  BACK_IN_STOCK
}
